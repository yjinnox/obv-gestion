# Copier ce fichier en `.env` (non versionné) à côté de docker-compose.prod.yml
# et renseigner les valeurs réelles avant `docker compose -f docker-compose.prod.yml up -d --build`.

# --- Base de données ---
DB_NAME=obv_gestion
DB_USER=obv
DB_PASSWORD=change-moi

# --- JWT ---
# Chaîne aléatoire longue (ex. `openssl rand -base64 48`) — jamais celle du dev.
JWT_SECRET=change-moi

# --- Nom de domaine + HTTPS automatique (Caddy / Let's Encrypt) ---
# Ex. via un sous-domaine gratuit DuckDNS : obv-gestion.duckdns.org
# Le domaine doit déjà pointer (enregistrement A) vers l'IP publique de la VM.
DOMAIN=obv-gestion.duckdns.org

# --- URL publique ---
# Adresse par laquelle les testeurs accèdent au frontend — doit correspondre
# à DOMAIN ci-dessus, en https. Utilisée dans les liens d'activation envoyés
# par email, et comme origine CORS autorisée.
APP_FRONTEND_URL=https://obv-gestion.duckdns.org

# --- Envoi d'email réel (ex. Brevo, gratuit jusqu'à 300/jour) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=votre-identifiant-smtp-brevo
MAIL_PASSWORD=votre-cle-smtp-brevo
# Adresse expéditrice : doit être un expéditeur vérifié côté Brevo.
NOTIFICATION_EMAIL_FROM=no-reply@votredomaine.example

# --- Premier compte SUPER_ADMINISTRATEUR (amorcé au premier démarrage) ---
BOOTSTRAP_ADMIN_NOM=Admin
BOOTSTRAP_ADMIN_PRENOMS=OBV
BOOTSTRAP_ADMIN_EMAIL=vous@exemple.com
